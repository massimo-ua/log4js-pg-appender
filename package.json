{
  "name": "@simoware/log4js-pg-appender",
  "engines": {
    "node": ">=20.0.0"
  },
  "version": "0.1.2",
  "description": "Simple Log4js postgresql appender",
  "main": "dist/log4js-pg-appender.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/log4js-pg-appender.min.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:db:up": "docker compose up -d --wait",
    "test:db:down": "docker compose down -v",
    "test:integration:run": "node --test test/integration/*.test.js",
    "test:integration": "node test/integration/run.js",
    "test:perf": "node test/perf/run.js",
    "test:perf:unit": "node --test test/perf/unit.perf.test.js",
    "test:perf:db": "node --test test/perf/postgres.perf.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && npm run lint:fix && npm run typecheck && npm run test",
    "build": "node build.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimo-ua/log4js-pg-appender.git"
  },
  "keywords": [],
  "author": "grishkov.m@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/massimo-ua/log4js-pg-appender/issues"
  },
  "homepage": "https://github.com/massimo-ua/log4js-pg-appender#readme",
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "log4js": "^6.9.1",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  }
}
